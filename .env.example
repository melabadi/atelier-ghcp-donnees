# Copiez ce fichier en .env (ignoré par Git) et remplissez les valeurs.
# Ne collez jamais un jeton dans le clavardage ni dans un fichier versionné.

# --- SQL Server local (scripts/valider.ps1 -Mode Local) ---
# Exemples : localhost, localhost,1433, .\SQLEXPRESS
SQL_SERVEUR=
# Valeurs possibles : windows (authentification intégrée) ou sql (utilisateur + mot de passe)
SQL_AUTHENTIFICATION=
SQL_UTILISATEUR=
SQL_MOT_DE_PASSE=

# --- Azure DevOps (skill azure-devops-workitem, démo) ---
# Exemple : https://dev.azure.com/mon-organisation
ADO_ORG_URL=
ADO_PROJET=
# PAT avec la portée Work Items (lecture et écriture)
ADO_PAT=

# --- Jira (skill jira-ticket, atelier) ---
# Exemple : https://mon-espace.atlassian.net
JIRA_URL=
# Valeurs possibles : cloud ou datacenter
JIRA_DEPLOIEMENT=
# Jira Cloud seulement : courriel du compte associé au jeton d'API
JIRA_COURRIEL=
# Cloud : jeton d'API; Data Center : jeton d'accès personnel (PAT)
JIRA_JETON=
